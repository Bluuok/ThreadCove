# Copy to .env and provide your own key. Never commit .env.
THREADCOVE_PROVIDER=pi
THREADCOVE_PI_PROVIDER=opencode-go
THREADCOVE_MODEL=deepseek-v4.1-flash
OPENCODE_GO_API_KEY=
# Alternatively configure the encrypted local credential with scripts/configure-opencode-go.ts.
# Direct provider alternatives: THREADCOVE_PROVIDER=deepseek or anthropic.
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# THREADCOVE_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# THREADCOVE_TOKEN=  # Omit to generate a random token on each startup.
