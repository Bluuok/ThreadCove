{
  "name": "@threadcove/electron",
  "version": "0.1.0",
  "description": "Desktop app: embedded WS server, transport layer, React session UI",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun run scripts/dev.ts",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --outfile=dist/main.cjs --external:electron --external:@anthropic-ai/claude-agent-sdk --external:@modelcontextprotocol/sdk --external:ws",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron",
    "build": "bun run build:main && bun run build:preload && vite build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@threadcove/core": "workspace:*",
    "@threadcove/shared": "workspace:*",
    "ws": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@threadcove/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
