{
  "name": "threadcove",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Personal deep-research workbench: multi-session isolation, pluggable agent backends, unified event stream, multi-client transport",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run typecheck:core && bun run typecheck:shared && bun run typecheck:pi-agent-server && bun run typecheck:electron && bun run typecheck:webui",
    "typecheck:core": "cd packages/core && bun run typecheck",
    "typecheck:shared": "cd packages/shared && bun run typecheck",
    "typecheck:pi-agent-server": "cd packages/pi-agent-server && bun run typecheck",
    "typecheck:electron": "cd apps/electron && bun run typecheck",
    "typecheck:webui": "cd apps/webui && bun run typecheck",
    "lint": "eslint .",
    "dev:electron": "bun run apps/electron/scripts/dev.ts",
    "dev:webui": "bun run --cwd apps/webui vite",
    "server:headless": "bun run apps/electron/src/server/headless.ts"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.2.7",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.3.0"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
